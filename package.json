{
  "author": "HERE (joincomehere.com)",
  "build": {
    "appId": "com.joincomehere.here",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "shortcutName": "HERE"
    },
    "productName": "HERE",
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    }
  },
  "description": "HERE for computers \u2014 the HERE platform in its own Mac + Windows app, with HERE Studio for going live.",
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^25.1.8"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "here-desktop",
  "private": true,
  "scripts": {
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "start": "electron ."
  },
  "version": "0.1.1"
}